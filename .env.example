# Required for production catalog, inventory, inquiries and orders.
DATABASE_URL=

# Temporary admin gate. Replace before production launch with a long random secret.
ADMIN_ACCESS_KEY=

# Optional: image uploads. If empty, the admin accepts image URLs and local placeholders.
BLOB_READ_WRITE_TOKEN=

# Keep false/empty in production. Demo data is only for local UI development.
ALLOW_DEMO_DATA=false

# Future integrations: leave blank until credentials are ready.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Use a separate secret for member sessions; never reuse the admin key in production.
MEMBER_SESSION_SECRET=
AUTH_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
RESEND_API_KEY=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
